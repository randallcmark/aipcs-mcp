prune tests
prune .agents
prune .codex
include .dockerignore CHANGELOG.md CODE_OF_CONDUCT.md CONTRIBUTING.md Dockerfile LICENSE NOTICE RELEASING.md SECURITY.md TRADEMARKS.md
recursive-include assets *.svg
recursive-include docs *.md
recursive-include examples *.md
global-exclude *.py[cod]
global-exclude *.sqlite *.sqlite3 *.db *.db3
